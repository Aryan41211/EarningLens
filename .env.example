# Copy this to .env and fill in LLM_API_KEY.
#
# LLM_MODEL_NAME must name a model the key can actually reach. Hosted models get
# retired without notice -- llama-3.3-70b-versatile was pinned here for weeks
# after Groq removed it, so every scoring run 404'd. List what yours can reach:
#
#   python scripts/check_models.py
#
# Changing the model invalidates every existing score for a dimension: re-score
# the whole series, never append. See SCORING_METHODOLOGY.md section 4.

LLM_API_KEY=
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=openai/gpt-oss-120b
